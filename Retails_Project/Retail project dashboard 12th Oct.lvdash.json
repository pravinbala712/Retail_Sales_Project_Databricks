{
  "datasets": [
    {
      "name": "8b34d798",
      "displayName": "gold_fact_sales",
      "config": {
        "version": "1.1",
        "source": "retails_project.gold.gold_fact_sales",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "f1b9ab8e",
      "displayName": "Total Revenue per Category",
      "queryLines": [
        "SELECT category, SUM(Total_Revenue) AS total_revenue\r\n",
        "FROM retails_project.gold.gold_fact_sales\r\n",
        "GROUP BY category;"
      ]
    },
    {
      "name": "28c38595",
      "displayName": "Total daily revenuie",
      "queryLines": [
        "SELECT\r\n",
        "    order_date,\r\n",
        "    SUM(Total_Revenue) AS daily_revenue\r\n",
        "FROM retails_project.gold.gold_fact_sales\r\n",
        "GROUP BY order_date\r\n",
        "ORDER BY order_date;"
      ]
    },
    {
      "name": "fd302dfe",
      "displayName": "Retail Category Sales Summary by Order Volume",
      "queryLines": [
        "SELECT\r\n",
        "    category,\r\n",
        "    SUM(Total_Orders) AS total_orders\r\n",
        "FROM retails_project.gold.gold_fact_sales\r\n",
        "GROUP BY category\r\n",
        "ORDER BY total_orders DESC;"
      ]
    }
  ],
